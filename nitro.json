{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "inksignpdf"
  ],
  "ios": {
    "iosModuleName": "ReactNativeInkSignPdf"
  },
  "android": {
    "androidNamespace": [
      "inksignpdf"
    ],
    "androidCxxLibName": "ReactNativeInkSignPdf"
  },
  "autolinking": {
    "InkSignView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "InkSignView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridInkSignView"
      }
    },
    "InkSignDocumentFactory": {
      "android": {
        "implementationClassName": "HybridInkSignDocumentFactory",
        "language": "kotlin"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "lib"
  ]
}

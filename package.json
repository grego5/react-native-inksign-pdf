{
  "name": "@grego5/react-native-inksign-pdf",
  "version": "1.0.0",
  "description": "A React Native Nitro Module for signing local PDFs with native, velocity-sensitive ink.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "android/CMakeLists.txt",
    "android/build.gradle",
    "android/src",
    "core/ink-engine/InkEngineSources.cmake",
    "core/ink-engine/include",
    "core/ink-engine/tracing/PerfettoTrace.hpp",
    "core/pdfium-adapter",
    "android/ink-engine-release.json",
    "core/third_party/pdfium",
    "tools/verify-pdfium.ps1",
    "THIRD_PARTY_NOTICES.md",
    "CREDITS.md",
    "ios",
    "lib",
    "nitrogen/generated",
    "src",
    "*.podspec",
    "nitro.json",
    "README.md"
  ],
  "scripts": {
    "nitrogen": "nitrogen",
    "build": "bob build",
    "test:stroke:fast": "node tools/test-stroke-replay-fast.mjs",
    "verify:pdfium": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-pdfium.ps1",
    "check:artifact-parity": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-managed-artifact-parity.ps1",
    "verify:change": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-change.ps1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json",
          "tsc": "./node_modules/typescript/bin/tsc6"
        }
      ]
    ]
  },
  "keywords": [
    "react-native",
    "nitro",
    "pdf",
    "signature",
    "apple-pencil"
  ],
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/react": "^19.0.0",
    "nitrogen": "0.37.1",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.0",
    "react-native-nitro-modules": "0.37.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
